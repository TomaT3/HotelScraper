# RapidAPI Key for Booking.com API (https://rapidapi.com/tipsters/api/booking-com)
RAPIDAPI_KEY=your_rapidapi_key_here

# Database path (relative to /app in container, or absolute)
DATABASE_URL=data/hotel_prices.db

# Scheduler: how many dates to fetch per run (Free Tier: ~15/day)
DATES_PER_RUN=3

# Scheduler: cron hour to run daily fetch (0-23, default 3 = 3 AM)
FETCH_HOUR=3

# Cities to search (comma-separated, default: Stuttgart)
SEARCH_CITIES=Stuttgart

# Initial admin account (seeded on first start, only if no admin exists yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
